{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "arara: 编译 LaTeX 文档",
      "type": "shell",
      "command": "arara",
      "args": ["-v", "report.tex"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "arara: 清理临时文件",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "rm -f *.aux *.log *.out *.toc *.bbl *.blg *.nav *.snm *.synctex.gz 2>/dev/null || true"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "arara: 强制重新编译",
      "type": "shell",
      "command": "arara",
      "args": ["-v", "report.tex"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "latex",
        "fileLocation": ["relative", "${fileDirname}"],
        "pattern": {
          "regexp": "^(.*):([0-9]+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
    {
      "label": "arara: 查看规则",
      "type": "shell",
      "command": "arara",
      "args": ["--rules"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
